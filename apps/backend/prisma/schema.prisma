generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventVisibility {
  PUBLIC
  AUTHENTICATED
  GUILD_MEMBERS
  PARTICIPANTS
}

enum ParticipationEligibility {
  AUTHENTICATED
  GUILD_MEMBERS
}

enum RefundRoundingUnit {
  TEN
  HUNDRED
  FIVE_HUNDRED
}

model User {
  id   String @id @default(uuid(7))
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  seriesMembers         SeriesMember[]
  answers               OffkaiAnswer[]        @relation("AnswerOwner")
  updatedAnswers        OffkaiAnswer[]        @relation("AnswerUpdater")
  photoShares           OffkaiPhotoShare[]    @relation("PhotoShareUploader")
  photoDownloadStatuses PhotoDownloadStatus[]
  kigurumis             Kigurumi[]            @relation("KigurumiOwner")
  authSessions          AuthSession[]
  passwordCredential    PasswordCredential?
  discordIdentity       DiscordIdentity?
}

model PasswordCredential {
  userId       String @id
  loginId      String @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscordIdentity {
  userId        String  @id
  discordUserId String  @unique
  username      String
  displayName   String?
  avatarHash    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String    @id
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Series {
  id                               String                   @id @default(uuid(7))
  name                             String
  preferenceQuestionTemplate       Json                     @default("[]")
  discordGuildId                   String?
  templateAskBringingKigurumi      Boolean                  @default(false)
  templateOverviewVisibility       EventVisibility          @default(AUTHENTICATED)
  templateParticipantsVisibility   EventVisibility          @default(AUTHENTICATED)
  templateParticipationEligibility ParticipationEligibility @default(AUTHENTICATED)
  staffPermissions                 Json                     @default("{\"showUnansweredEvents\":true,\"allowApplicationBeforeStart\":false,\"eventManagement\":false,\"answerManagement\":\"read\",\"discordRole\":\"manage\",\"feeCalculation\":\"confirm\",\"feeCollection\":\"record\",\"settlement\":\"confirm\",\"refund\":\"record\"}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members SeriesMember[]
  events  OffkaiEvent[]
}

model SeriesMember {
  seriesId String
  userId   String
  role     String // "owner" | "staff"

  series Series @relation(fields: [seriesId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@id([seriesId, userId])
}

model OffkaiEvent {
  id String @id @default(uuid(7))

  seriesId String

  name                   String
  description            String?
  participantDescription String?

  eventStartDate           DateTime                 @db.Date
  eventEndDate             DateTime                 @db.Date
  applicationStartDate     DateTime
  discordRoleId            String?
  askBringingKigurumi      Boolean                  @default(false)
  overviewVisibility       EventVisibility          @default(AUTHENTICATED)
  participantsVisibility   EventVisibility          @default(AUTHENTICATED)
  participationEligibility ParticipationEligibility @default(AUTHENTICATED)

  preferenceQuestions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  series              Series               @relation(fields: [seriesId], references: [id])
  answers             OffkaiAnswer[]
  commitmentQuestions CommitmentQuestion[]
  finance             EventFinance?
  photoShares         OffkaiPhotoShare[]
}

model CommitmentQuestion {
  id      String @id
  eventId String

  question      String
  questionShort String
  deadline      DateTime
  description   String
  capacity      Int
  required      Boolean   @default(false)
  sortOrder     Int
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event                OffkaiEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers              CommitmentAnswer[]
  settlementCategories SettlementCategory[]

  @@index([eventId, archivedAt, sortOrder])
}

model OffkaiAnswer {
  id String @id @default(uuid(7))

  eventId        String
  userId         String?
  respondentName String
  updatedBy      String

  preferenceAnswers Json
  bringingKigurumis Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event   OffkaiEvent @relation(fields: [eventId], references: [id])
  user    User?       @relation("AnswerOwner", fields: [userId], references: [id])
  updater User        @relation("AnswerUpdater", fields: [updatedBy], references: [id])

  histories                   OffkaiAnswerHistory[]
  commitmentAnswers           CommitmentAnswer[]
  settlementCategoryMembers   SettlementCategoryMember[]
  settlementExpenseRecipients SettlementExpenseRecipient[]
  finance                     ParticipantFinance?
  payment                     ParticipantPayment?

  @@unique([eventId, userId])
}

model EventFinance {
  eventId String @id

  refundRoundingUnit     RefundRoundingUnit @default(TEN)
  feeCalculationLockedAt DateTime?
  collectionStartedAt    DateTime?
  settlementLockedAt     DateTime?
  refundStartedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event      OffkaiEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categories SettlementCategory[]
}

model SettlementCategory {
  id      String @id @default(uuid(7))
  eventId String

  name                       String
  baseParticipationFeeAmount Int     @default(0)
  commitmentQuestionId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  finance            EventFinance               @relation(fields: [eventId], references: [eventId], onDelete: Cascade)
  commitmentQuestion CommitmentQuestion?        @relation(fields: [commitmentQuestionId], references: [id], onDelete: Restrict)
  members            SettlementCategoryMember[]
  expenses           SettlementExpense[]
  incomes            SettlementIncome[]

  @@unique([eventId, name])
  @@index([commitmentQuestionId])
}

model SettlementCategoryMember {
  categoryId String
  answerId   String

  amountOverride Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  category SettlementCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  answer   OffkaiAnswer       @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([categoryId, answerId])
  @@index([answerId])
}

model SettlementExpense {
  id         String @id @default(uuid(7))
  categoryId String

  title  String
  amount Int
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  category   SettlementCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recipients SettlementExpenseRecipient[]

  @@index([categoryId, createdAt])
}

model SettlementExpenseRecipient {
  expenseId String
  answerId  String
  amount    Int

  expense SettlementExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  answer  OffkaiAnswer      @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([expenseId, answerId])
  @@index([answerId])
}

model SettlementIncome {
  id         String @id @default(uuid(7))
  categoryId String

  title  String
  amount Int
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  category SettlementCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, createdAt])
}

model ParticipantFinance {
  answerId String @id

  chargeAmount Int       @default(0)
  note         String?
  collectedAt  DateTime?

  refundAmount       Int?
  refundCalculatedAt DateTime?
  refundedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  answer       OffkaiAnswer             @relation(fields: [answerId], references: [id], onDelete: Cascade)
  extraCharges ParticipantExtraCharge[]
}

model ParticipantExtraCharge {
  id       String @id @default(uuid(7))
  answerId String

  title  String
  amount Int
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  participantFinance ParticipantFinance @relation(fields: [answerId], references: [answerId], onDelete: Cascade)

  @@index([answerId])
}

model CommitmentAnswer {
  answerId   String
  questionId String

  answer Boolean?

  answerRecord OffkaiAnswer       @relation(fields: [answerId], references: [id], onDelete: Cascade)
  question     CommitmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([answerId, questionId])
  @@index([questionId, answer])
}

model ParticipantPayment {
  answerId String @id

  amount    Int     @default(0)
  collected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  answer OffkaiAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

model OffkaiAnswerHistory {
  id String @id @default(uuid(7))

  offkaiAnswerId String
  eventId        String
  userId         String?

  commitmentAnswers Json
  preferenceAnswers Json
  bringingKigurumis Json @default("[]")

  createdAt DateTime @default(now())

  answer OffkaiAnswer @relation(fields: [offkaiAnswerId], references: [id])
}

model Kigurumi {
  id          String @id @default(uuid(7))
  ownerUserId String

  title     String
  character String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner User @relation("KigurumiOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
}

model OffkaiPhotoShare {
  id String @id @default(uuid(7))

  eventId        String
  uploaderUserId String

  url              String
  downloadDeadline String?
  password         String?
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event            OffkaiEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader         User                  @relation("PhotoShareUploader", fields: [uploaderUserId], references: [id])
  downloadStatuses PhotoDownloadStatus[]

  @@index([eventId, createdAt])
}

model PhotoDownloadStatus {
  photoShareId String
  userId       String

  checkedAt DateTime @default(now())

  photoShare OffkaiPhotoShare @relation(fields: [photoShareId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])

  @@id([photoShareId, userId])
}
