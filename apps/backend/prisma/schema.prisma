generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(uuid(7))
  loginId      String @unique
  name         String
  passwordHash String
  discordUsername    String? @unique
  discordUserId      String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  seriesMembers         SeriesMember[]
  answers               OffkaiAnswer[]        @relation("AnswerOwner")
  updatedAnswers        OffkaiAnswer[]        @relation("AnswerUpdater")
  photoShares           OffkaiPhotoShare[]    @relation("PhotoShareUploader")
  photoDownloadStatuses PhotoDownloadStatus[]
  kigurumis             Kigurumi[]            @relation("KigurumiOwner")
}

model Series {
  id                         String @id @default(uuid(7))
  name                       String
  preferenceQuestionTemplate Json   @default("[]")
  discordGuildId             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  members SeriesMember[]
  events  OffkaiEvent[]
}

model SeriesMember {
  seriesId String
  userId   String
  role     String // "owner" | "staff"

  series Series @relation(fields: [seriesId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@id([seriesId, userId])
}

model OffkaiEvent {
  id String @id @default(uuid(7))

  seriesId String

  name        String
  description String?

  eventStartDate       DateTime @db.Date
  eventEndDate         DateTime @db.Date
  applicationStartDate DateTime
  discordRoleId        String?
  askBringingKigurumi Boolean @default(false)

  commitmentQuestions Json
  preferenceQuestions Json

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  series      Series             @relation(fields: [seriesId], references: [id])
  answers     OffkaiAnswer[]
  photoShares OffkaiPhotoShare[]
}

model OffkaiAnswer {
  id String @id @default(uuid(7))

  eventId   String
  userId    String
  updatedBy String

  commitmentAnswers Json
  preferenceAnswers Json
  bringingKigurumis Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event   OffkaiEvent @relation(fields: [eventId], references: [id])
  user    User        @relation("AnswerOwner", fields: [userId], references: [id])
  updater User        @relation("AnswerUpdater", fields: [updatedBy], references: [id])

  histories OffkaiAnswerHistory[]
  payment   ParticipantPayment?

  @@unique([eventId, userId])
}

model ParticipantPayment {
  answerId String @id

  amount         Int     @default(0)
  collected      Boolean @default(false)
  changeReturned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  answer OffkaiAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
}

model OffkaiAnswerHistory {
  id String @id @default(uuid(7))

  offkaiAnswerId String
  eventId        String
  userId         String

  commitmentAnswers Json
  preferenceAnswers Json
  bringingKigurumis Json @default("[]")

  createdAt DateTime @default(now())

  answer OffkaiAnswer @relation(fields: [offkaiAnswerId], references: [id])
}

model Kigurumi {
  id          String @id @default(uuid(7))
  ownerUserId String

  title     String
  character String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  owner User @relation("KigurumiOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
}

model OffkaiPhotoShare {
  id String @id @default(uuid(7))

  eventId        String
  uploaderUserId String

  url              String
  downloadDeadline String?
  password         String?
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event            OffkaiEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader         User                  @relation("PhotoShareUploader", fields: [uploaderUserId], references: [id])
  downloadStatuses PhotoDownloadStatus[]

  @@index([eventId, createdAt])
}

model PhotoDownloadStatus {
  photoShareId String
  userId       String

  checkedAt DateTime @default(now())

  photoShare OffkaiPhotoShare @relation(fields: [photoShareId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])

  @@id([photoShareId, userId])
}
